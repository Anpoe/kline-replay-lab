# 复制为 .env.local；只填写在本机，不要提交真实密钥。
# BaoStock 全市场初始化的并发路数，默认 3，建议不要超过 6。
BAOSTOCK_CONCURRENCY=3
TUSHARE_TOKEN=
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
TWELVE_DATA_API_KEY=
# 可选：覆盖内置 Dukascopy 官方适配器的 CSV 地址；留空即可。
DUKASCOPY_CSV_ENDPOINT=
# 可选：允许通过远程域名访问开发 WebUI，例如 your-domain.example。
KLINE_REMOTE_HOST=
